nextflow_pipeline {

    name "Test Voyager successful profiling and MultiQC integration"
    script "../main.nf"
    tag "pipeline"
    tag "voyager"

    test("Voyager profile reaches MultiQC") {

        config "../conf/test_voyager_success.config"

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def voyager_profile = path("$outputDir/voyager/test.voyager.json")
            def voyager_status = path("$outputDir/voyager/test.voyager_mqc.tsv")
            def multiqc_report = path("$outputDir/multiqc/multiqc_report.html")
            def multiqc_voyager = path("$outputDir/multiqc/multiqc_data/multiqc_test.voyager.txt")

            assertAll(
                { assert workflow.success },
                { assert voyager_profile.exists() && voyager_profile.size() > 0 },
                { assert voyager_profile.text.contains('"global"') && voyager_profile.text.contains('"genomes"') },
                { assert voyager_status.readLines()[1].contains('\tsuccess\t') },
                { assert multiqc_report.exists() },
                { assert multiqc_voyager.readLines()[1].contains('\tsuccess\t') },
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/nf-core-contam_software_mqc_versions.yml")
                ).match() }
            )
        }
    }
}
