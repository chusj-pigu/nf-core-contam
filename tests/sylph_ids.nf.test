nextflow_pipeline {

    name "Test automatic cached Sylph identifier provisioning"
    script "../main.nf"
    tag "pipeline"
    tag "sylph_ids"

    test("Multiple official IDs populate the local cache and reach MultiQC") {

        config "../conf/test_sylph_ids.config"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                sylph_db_cache_dir = "$outputDir/sylph-cache-v2"
            }
        }

        then {
            def globdb_database = path("$outputDir/sylph-cache-v2/globdb_r232_sylph_c200.syldb")
            def fungi_database = path("$outputDir/sylph-cache-v2/fungi-refseq-2025-10-11-c200-dbv1.syldb")
            def imgvr_database = path("$outputDir/sylph-cache-v2/imgvr_c200_v0.3.0.syldb")
            def globdb_taxonomy = path("$outputDir/sylph-cache-v2/taxonomy/globdb_r232_sylph_tax.tsv.gz")
            def fungi_taxonomy = path("$outputDir/sylph-cache-v2/taxonomy/fungi_refseq_2025-10-11_metadata.tsv.gz")
            def imgvr_taxonomy = path("$outputDir/sylph-cache-v2/taxonomy/IMGVR_4.1_metadata.tsv.gz")
            def sylph_taxonomy = path("$outputDir/sylphtax")
            def multiqc_report = path("$outputDir/multiqc/multiqc_report.html")
            def versions = path("$outputDir/pipeline_info/nf-core-contam_software_mqc_versions.yml")

            assertAll(
                { assert workflow.success },
                { assert globdb_database.exists() && globdb_database.size() > 0 },
                { assert fungi_database.exists() && fungi_database.size() > 0 },
                { assert imgvr_database.exists() && imgvr_database.size() > 0 },
                { assert globdb_taxonomy.exists() && globdb_taxonomy.size() > 0 },
                { assert fungi_taxonomy.exists() && fungi_taxonomy.size() > 0 },
                { assert imgvr_taxonomy.exists() && imgvr_taxonomy.size() > 0 },
                { assert sylph_taxonomy.exists() },
                { assert multiqc_report.exists() },
                { assert snapshot(removeNextflowVersion(versions.toString())).match() }
            )
        }
    }
}
